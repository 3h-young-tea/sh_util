{
	"workbench.colorTheme": "Github Light Theme",
	"chat.disableAIFeatures": true,
	"editor.fontFamily": "'Ubuntu Mono'",
	"editor.tabSize": 8,
	"editor.insertSpaces": false,
	"editor.fontSize": 16,
	"extensions.ignoreRecommendations": true,
	"workbench.iconTheme": "vs-minimal",
	"workbench.editor.enablePreview": false,
	"code-runner.executorMap": {
		"cpp": "cd $dir && g++-16 -o $fileNameWithoutExt.elf $fileName -std=c++26 -O2 -static -pipe && /mnt/c/code/runner.elf ./$fileNameWithoutExt.elf && rm ./$fileNameWithoutExt.elf"
	},
	"code-runner.runInTerminal": true,
	"code-runner.saveAllFilesBeforeRun": true,
	"code-runner.saveFileBeforeRun": true,
	"editor.minimap.enabled": false,
	"editor.renderLineHighlight": "none",
	"C_Cpp.default.cppStandard": "c++26",
	"C_Cpp.default.cStandard": "c23",

	"editor.suggest.showSnippets": true,
	"editor.suggest.showVariables": false,
	"editor.suggest.showFunctions": false,
	"editor.suggest.showKeywords": false,
	"editor.suggest.showClasses": false,
		"editor.quickSuggestions": {
		"other": true,
		"comments": false,
		"strings": false
	},
	"editor.suggestOnTriggerCharacters": false,
	"editor.wordBasedSuggestions": "off",
	"editor.autoClosingBrackets": "never",
	"editor.wordWrap": "on",
	"editor.wordWrapColumn": 1073741824,
	"editor.wrappingIndent": "none",
	"security.workspace.trust.untrustedFiles": "open",
	"editor.accessibilitySupport": "off"
}
